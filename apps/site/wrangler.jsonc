{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.js",
  "name": "dustswap-site",
  "routes": [
    {
      "pattern": "dustswap.wtf",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2024-12-30",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
