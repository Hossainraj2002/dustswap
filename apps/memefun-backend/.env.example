# memefun backend. Copy to .env.local for local development; set these as service variables in
# production. Never commit real values.

# --- Chain ---------------------------------------------------------------------------------
# local (base-anvil from `pnpm dev:chain`) | base-sepolia | base
MEMEFUN_CHAIN=local
# Comma-separated RPC endpoints, first is primary. Base mainnet must use the paid endpoints.
MEMEFUN_RPC_URLS=http://127.0.0.1:8545
# Extra router contracts whose trades are attributed to the transaction sender (optional).
MEMEFUN_EXTRA_ROUTERS=

# --- Database --------------------------------------------------------------------------------
# One Postgres: Ponder's tables (schema per deployment) and the app's own schema (memefun_app).
DATABASE_URL=postgres://memefun:memefun@127.0.0.1:54329/memefun
# `ponder start` / `ponder serve` schema (required outside `ponder dev`).
DATABASE_SCHEMA=
# Optional low-traffic connection limits. Defaults preserve the existing deployment sizes.
# Ponder reserves 2 internal connections and divides the rest between 3 pools (minimum 8).
MEMEFUN_PONDER_POOL_MAX=20
MEMEFUN_DB_READ_POOL_MAX=10
MEMEFUN_DB_APP_POOL_MAX=10
# Releases only idle clients already returned to a pool; checked-out lock/transaction clients stay.
# 1000..60000 ms. API pool limits do not override the keeper's explicit 4-client pools.
MEMEFUN_DB_IDLE_TIMEOUT_MS=10000

# --- API -------------------------------------------------------------------------------------
# Public base URL of this API (OG cards and local media URLs point here).
PUBLIC_API_URL=http://localhost:42069
# Optional HTTPS CDN origin for anonymous public reads; leave empty for local development.
# Keep PUBLIC_API_URL canonical and deploy the keeper metadata compatibility fix first.
PUBLIC_DELIVERY_URL=
# Origins allowed to call write endpoints and to appear in SIWE messages.
ALLOWED_ORIGINS=http://localhost:3100
# HMAC secret for sign-in sessions (at least 32 random characters).
SIWE_SESSION_SECRET=
# Admin endpoints (/v1/admin/*): send as x-admin-token (at least 32 random characters).
ADMIN_TOKEN=

# Optional o1 Launchpad key, scoped tokens:read. Never expose this as NEXT_PUBLIC_.
# Without it, pair discovery truthfully shows only the limited keyless o1 Alpha list.
O1_API_KEY=

# --- Media -----------------------------------------------------------------------------------
# local: files under MEDIA_LOCAL_DIR. bucket: shared S3-compatible storage (testnet).
# pinata: pinned to IPFS through Pinata, mirrored to R2 (production).
MEDIA_STORE=local
MEDIA_LOCAL_DIR=./data/media
# Optional 1..8 image-processing threads. Leave blank for Sharp's platform default.
# Pair MALLOC_ARENA_MAX=2 with MEMEFUN_SHARP_CONCURRENCY=1 when testing Linux allocator tuning.
MEMEFUN_SHARP_CONCURRENCY=
# bucket credentials stay server-side on the API and keeper services. Do not use NEXT_PUBLIC_.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
PINATA_JWT=
PINATA_GATEWAY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Keeper ----------------------------------------------------------------------------------
# One key per role. On the local chain these are anvil's public dev keys (accounts 0, 8, 9).
KEEPER_PRIVATE_KEY=
PRICE_KEEPER_PRIVATE_KEY=
REWARDS_PUBLISHER_PRIVATE_KEY=
KEEPER_DRY_RUN=false
# Optional assertion. Every keeper role uses DustSwap's registered ERC-8021 attribution.
MEMEFUN_BUILDER_CODE=bc_tpolfjho
# Launch by tweet. Keys stay server-side; missing configuration keeps imports/signing unavailable.
GETX_API_KEY=
# Shared across API replicas and restarts. 0 disables paid reads; cache hits remain available.
# Keep within 0..10000; the default allows at most 100 paid tweet-detail requests per UTC day.
GETX_TWEET_DAILY_LIMIT=100
X_CLIENT_ID=
X_CLIENT_SECRET=
# Official X users/me reads have a separate shared budget. 0 disables new verification flows.
X_AUTHOR_VERIFY_DAILY_LIMIT=10
# Register this exact callback in the official X OAuth app (read scopes only).
X_REDIRECT_URI=
# This signer must equal MemeFunConfig.tweetAttestor(). No local or production fallback key.
TWEET_ATTESTOR_PRIVATE_KEY=

# --- Optional platform-token launch reward campaign -----------------------------------------
# Off until this separate distributor is configured, fully funded and activated onchain.
MEMEFUN_LAUNCH_REWARD_ENABLED=false
MEMEFUN_LAUNCH_REWARD_CONTRACT=
# Optional assertion of the immutable reward token; chain metadata and amount are authoritative.
MEMEFUN_LAUNCH_REWARD_TOKEN=
MEMEFUN_LAUNCH_REWARD_TOKEN_NAME=
MEMEFUN_LAUNCH_REWARD_TOKEN_SYMBOL=
# Dedicated campaign signer, matching campaignSigner(); never use an owner/keeper fallback.
MEMEFUN_LAUNCH_REWARD_SIGNER_PRIVATE_KEY=
# Optional fail-closed assertion, NOT a rule toggle. The owner enables the rule onchain once.
MEMEFUN_LAUNCH_REWARD_REQUIRE_TRADE=false
MEMEFUN_LAUNCH_REWARD_TICKET_TTL_SEC=300

# --- Optional official platform-token announcement/selection (Base mainnet only) ------------
# Leave either blank to disable. Public settings; these do not activate or fund launch rewards.
MEMEFUN_PLATFORM_TOKEN_LAUNCH_AT=
MEMEFUN_PLATFORM_TOKEN_LAUNCHER=

# --- Optional economy runtime (Railway production profile) --------------------------------
# Start with `pnpm start:economy`; keep the same physical schema on every wake in a deployment.
# Railway supplies RAILWAY_DEPLOYMENT_ID. Set MEMEFUN_INDEX_SCHEMA explicitly for local canaries.
MEMEFUN_INDEX_SCHEMA=
MEMEFUN_API_IDLE_MS=30000
MEMEFUN_API_WARMUP_MS=600000
# Keep below the frontend's 15-second and keeper's 20-second attempt timeouts so callers
# receive the gateway's explicit retryable 503 instead of aborting before it arrives.
MEMEFUN_API_WAIT_MS=10000
# Keeper cron: `node --import tsx keeper/main.ts --once`, every five minutes.
# Catch-up is mandatory when the API can idle; use the direct origin to avoid CDN caching.
MEMEFUN_INDEXER_WAKE_URL=
MEMEFUN_INDEXER_WAKE_TIMEOUT_MS=600000
