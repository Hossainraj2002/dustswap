{
  "name": "@dustswap/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "test:wallet-rpc": "node --experimental-strip-types --test tests/dustsweep-wallet-rpc.test.mjs",
    "type-check": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-org/account": "2.4.0",
    "@bigmi/react": "^0.7.1",
    "@farcaster/mini-app-solana": "^1.1.3",
    "@metamask/connect-evm": "^0.9.1",
    "@openocean.finance/widget": "^1.0.66",
    "@privy-io/chains": "^0.1.4",
    "@privy-io/react-auth": "^3.28.0",
    "@privy-io/wagmi": "^4.0.10",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@tanstack/react-query": "^5.72.0",
    "next": "15.1.11",
    "ox": "^0.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.52.0",
    "wagmi": "^3.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.8.2",
    "@tailwindcss/forms": "^0.5.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.37.0"
  }
}
