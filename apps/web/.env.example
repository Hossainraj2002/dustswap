# Copy to .env.local and fill in values - never commit .env.local.

# Base / Alchemy RPC
# Set 1 - Recommended rotation setup.
# Fill ONE rotated-key list in most setups. If you fill both, both lists are combined.
NEXT_PUBLIC_ALCHEMY_API_KEYS=key_one,key_two,key_three
NEXT_PUBLIC_ALCHEMY_BASE_RPC_KEYS=

# Set 2 - Optional single-key fallback.
# This is only used after the rotated keys above.
NEXT_PUBLIC_ALCHEMY_API_KEY=your_fallback_alchemy_key_here

# OnchainKit (get from https://portal.cdp.coinbase.com - free)
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_onchainkit_key_here

# Paymaster URL (from Coinbase CDP portal - enables sponsored gas)
# See: https://docs.base.org/base-account/improve-ux/sponsor-gas/paymasters
NEXT_PUBLIC_PAYMASTER_URL=https://api.developer.coinbase.com/rpc/v1/base/YOUR_KEY

# Builder Code (from https://base.org/builders/builder-codes)
# This earns you a share of gas fees Base collects from your users
NEXT_PUBLIC_BUILDER_CODE=your_builder_code_here

# LI.FI
# Integrator name is used for analytics/tracking in LI.FI requests.
NEXT_PUBLIC_LIFI_INTEGRATOR=DustSwap
# Optional: only set this after fee wallets are configured for your LI.FI integrator.
# Example: 0.002 = 0.2%
NEXT_PUBLIC_LIFI_FEE=

# Set 3 - Optional custom RPC URLs used by both Wagmi and the LI.FI widget.
# Leave blank unless you want to override the Alchemy-generated Base RPC URLs.
NEXT_PUBLIC_BASE_RPC_URLS=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_ARBITRUM_RPC_URL=
NEXT_PUBLIC_OPTIMISM_RPC_URL=
NEXT_PUBLIC_POLYGON_RPC_URL=
NEXT_PUBLIC_BSC_RPC_URL=
NEXT_PUBLIC_AVALANCHE_RPC_URL=

# Neynar API Key for Farcaster profiles
NEYNAR_API_KEY=your_neynar_api_key_here

# WalletConnect Project ID (from cloud.walletconnect.com - free)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
# Backward-compatible aliases also work: NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID or NEXT_PUBLIC_WC_PROJECT_ID.
# Privy App ID (from dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public site URL used for app links and shared callback configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public invite link used by Discord connect/profile/quest buttons. Do not put
# Discord client secret or bot token in frontend env.
NEXT_PUBLIC_DISCORD_INVITE_URL=
# Leave false to hide the Volume tab on /leaderboard. Set true and redeploy
# the web app to make it public again.
NEXT_PUBLIC_VOLUME_LEADERBOARD_ENABLED=false

# Deployed contract addresses (fill in after running forge script/Deploy.s.sol)
NEXT_PUBLIC_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DUST_SWEEP_ROUTER=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DUST_SWEEP_EXECUTION_LANE=owned_v2
NEXT_PUBLIC_DUST_SWEEP_ROUTER_V2_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DUST_SWEEP_FEE_BPS=60
NEXT_PUBLIC_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
NEXT_PUBLIC_BURN_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FEE_COLLECTOR_ADDRESS=0x0000000000000000000000000000000000000000

# Set to 'testnet' for development, 'mainnet' for production
NEXT_PUBLIC_NETWORK=testnet

# Maintenance: MAINTENANCE_MODE=1 redirects users to /maintenance.
# Optional bypass: set MAINTENANCE_BYPASS_SECRET (match API) and
# MAINTENANCE_BYPASS_PASSWORD so operators can unlock via /maintenance.
# If secret or password is unset, behavior is full lockout (same as before).
# MAINTENANCE_MODE=1
# MAINTENANCE_BYPASS_SECRET=
# MAINTENANCE_BYPASS_PASSWORD=
# ISO-8601 end time for countdown on /maintenance (optional).
# NEXT_PUBLIC_MAINTENANCE_END_AT=2026-05-10T22:00:00.000Z
# Optional custom message (plain text) on maintenance page.
# NEXT_PUBLIC_MAINTENANCE_MESSAGE=
