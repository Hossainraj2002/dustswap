{
  "name": "dustsweep-api",
  "version": "1.0.0",
  "description": "DustSweep backend API",
  "packageManager": "pnpm@9.15.4",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "grant-existing-user-reward": "ts-node src/scripts/grantExistingUserReward.ts",
    "sync-dustsweep-whitelist": "ts-node src/scripts/syncDustSweepWhitelist.ts",
    "sync-dustsweep-whitelist:blockscout": "ts-node src/scripts/syncDustSweepWhitelistBlockscout.ts",
    "sync-dustsweep-whitelist:onchain": "ts-node src/scripts/syncDustSweepWhitelistOnchain.ts",
    "sync-dustsweep-whitelist:pool-events": "ts-node src/scripts/syncDustSweepWhitelistPoolEvents.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@base-org/account": "2.4.0",
    "@hono/node-server": "^1.13.7",
    "@lifi/sdk": "^3.16.2",
    "@supabase/supabase-js": "^2.39.0",
    "alchemy-sdk": "^3.1.2",
    "bullmq": "^5.1.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.2",
    "ethers": "^6.10.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "hono": "^4.6.20",
    "ioredis": "^5.3.2",
    "siwe": "^2.3.2",
    "viem": "^2.23.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.35",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
