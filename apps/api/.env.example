# Copy to .env and fill in values — never commit .env!

PORT=3001
NODE_ENV=development

# Alchemy (get from alchemy.com — free tier works)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Supabase (from supabase.com > Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Preferred for backend writes, admin actions, and quest verification.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional fallback if service role is not set, but less powerful than service role.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Upstash Redis (from upstash.com)
REDIS_URL=https://YOUR_DB.upstash.io
REDIS_TOKEN=your_upstash_token_here

# RPC URLs
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# DustSweepRouter contract address (deployed on Base)
DUST_SWEEP_ROUTER_ADDRESS=your_deployed_contract_address_here

# Quest / X setup
# Public web app URL used by the API for X auth return links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Temporary admin auth for /admin/quests. Use a long random string.
QUEST_ADMIN_TOKEN=replace_with_long_random_admin_token
# X OAuth app settings.
X_CLIENT_ID=your_x_oauth_client_id_here
# Optional for PKCE-capable apps, but recommended to keep available.
X_CLIENT_SECRET=your_x_oauth_client_secret_here
X_REDIRECT_URI=http://localhost:3001/api/quests/x/callback
# Used for one-call tweet verification in the quest system.
X_BEARER_TOKEN=your_x_bearer_token_here
# Long random string used to sign X OAuth state.
X_STATE_SECRET=replace_with_long_random_state_secret
