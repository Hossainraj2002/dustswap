# Copy to .env and fill in values — never commit .env!

PORT=3001
NODE_ENV=development

# Alchemy (get from alchemy.com — free tier works)
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_BASE_RPC_KEYS=key_one,key_two,key_three
ALCHEMY_BASE_RPC_URLS=
BASE_RPC_ROTATION_CALLS=100
# Keep public Base RPC as a last fallback after configured RPC/Blockscout endpoints.
BASE_RPC_PUBLIC_FALLBACK=1

# Supabase (from supabase.com > Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Preferred for backend writes, admin actions, and quest verification.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional fallback if service role is not set, but less powerful than service role.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Upstash Redis (from upstash.com)
REDIS_URL=https://YOUR_DB.upstash.io
REDIS_TOKEN=your_upstash_token_here

# RPC URLs
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# DustSweepRouter contract address (deployed on Base)
DUST_SWEEP_ROUTER_ADDRESS=your_deployed_contract_address_here
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
DUST_SWEEP_FEE_BPS=200
DUST_SWEEP_MIN_VALUE_USD=0.01
DUST_SWEEP_ENABLE_AGGREGATORS=true
DUST_SWEEP_WHITELIST_MIN_LIQUIDITY_USD=1000
DUST_SWEEP_WHITELIST_DEX_IDS=aerodrome,pancakeswap-v3-base,baseswap,uniswap-v3-base
DUST_SWEEP_WHITELIST_SYNC_DELAY_MS=250
DUST_SWEEP_WHITELIST_MAX_RETRIES=6
DUST_SWEEP_WHITELIST_RETRY_MS=15000
DUST_SWEEP_ONCHAIN_SYNC_DELAY_MS=0
DUST_SWEEP_TOKEN_LIST_URLS=
DUST_SWEEP_TOKEN_LIST_SYNC_DELAY_MS=150
DUST_SWEEP_ADMIN_TOKEN=replace_with_long_random_admin_token

# DustSweep DEX addresses on Base. Defaults are Base mainnet; override only if a DEX
# upgrades/migrates or if you intentionally fork this API for another chain.
UNISWAP_V3_QUOTER_ADDRESS=0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a
UNISWAP_V3_FACTORY_ADDRESS=0x33128a8fC17869897dcE68Ed026d694621f6FDfD
PANCAKE_V3_QUOTER_ADDRESS=0xB048Bbc1Ee6b733FFfCFb9e9CeF7375518e25997
PANCAKE_V3_FACTORY_ADDRESS=0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865
AERODROME_ROUTER_ADDRESS=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
AERODROME_FACTORY_ADDRESS=0x420DD381b31aEf6683db6B902084cB0FFECe40Da
BASESWAP_ROUTER_ADDRESS=0x327Df1E6de05895d2ab08513aaDD9313Fe505d86
BASESWAP_FACTORY_ADDRESS=0xFDa619b6d20975be80A10332cD39b9a4b0FAa8BB

# Optional indexed-log / JSON-RPC fallback source. If set, DustSweep whitelist
# discovery and Base transaction verification can rotate through Blockscout keys.
BLOCKSCOUT_BASE_API_URL=https://base.blockscout.com/api
BLOCKSCOUT_BASE_API_V2_URL=https://base.blockscout.com/api/v2
BLOCKSCOUT_API_KEYS=
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_MAX_REQUESTS_PER_KEY=100
DUST_SWEEP_BLOCKSCOUT_SYNC_DELAY_MS=0
DUST_SWEEP_POOL_EVENT_SYNC_DELAY_MS=150
DUST_SWEEP_DEXSCREENER_MAX_RETRIES=8
DUST_SWEEP_DEXSCREENER_RETRY_MS=15000

# Optional fallback quote providers. 0x is wired for DustSweep aggregator routes.
ZEROX_API_KEY=
# Required for 0x aggregator routes. Include the 0x transaction.to target returned by
# quote testing plus the allowance holder spender, and call setAllowedTarget() on the
# DustSweepRouter for the same addresses. Leave empty to skip aggregator routes safely.
DUST_SWEEP_ALLOWED_AGGREGATOR_TARGETS=
UNISWAP_API_KEY=
ONEINCH_API_KEY=

# Quest / X setup
# Public web app URL used by the API when it needs to build return links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional extra browser origins allowed to call this API. Use this on Railway
# for Cloudflare Pages/custom domains, comma-separated, without a trailing /api.
# Example: CORS_ORIGINS=https://dustswap.wtf,https://dustswap.pages.dev
CORS_ORIGINS=
# Temporary admin auth for /admin/quests. Use a long random string.
QUEST_ADMIN_TOKEN=replace_with_long_random_admin_token
# Official X OAuth 2.0 account connection.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:3001/api/quests/x/callback
# By default OAuth access/refresh tokens are discarded after account ownership is verified.
X_STORE_OAUTH_TOKENS=false

# Discord OAuth account connection and server membership verification.
# Keep client secret and bot token backend-only. Rotate these if they were exposed.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=http://127.0.0.1:3001/api/quests/discord/callback
DISCORD_INVITE_URL=

# GetX API powers cheap backend-only social verification.
GETX_API_KEY=
GETX_API_BASE=https://api.getxapi.com
GETX_TIMEOUT_MS=8000
# Stable targets for follow verification. User IDs are preferred; username is a fallback.
DUSTSWAP_X_USER_ID=
DUSTSWAP_X_USERNAME=DustswapOnBase
FOUNDER_X_USER_ID=
FOUNDER_X_USERNAME=akbarx402
FOOTPRINT_DUSTSWAP_X_USER_ID=
FOOTPRINT_DUSTSWAP_X_USERNAME=DustswapOnBase
DUSTSWAP_LAUNCH_TWEET_ID=

# Cloudflare R2 profile image uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dustswap-profile-pfps
R2_PUBLIC_BASE_URL=https://pfp.dustswap.wtf
R2_REGION=auto

# Referral rewards
# Base referral commission percent applied to eligible user-earned points.
REFERRAL_COMMISSION_PCT=20
# Future NFT bonus toggles for referral commission boosts.
REFERRAL_FOUNDER_PASS_CONTRACT=
REFERRAL_FOUNDER_PASS_BONUS_PCT=60
REFERRAL_COFOUNDER_PASS_CONTRACT=
REFERRAL_COFOUNDER_PASS_BONUS_PCT=30

# Check-in streak recovery
# Leave unset/false to reset missed streaks to 0. Set to true to re-enable
# the paid $1 streak recovery flow without changing code.
STREAK_RECOVERY_ENABLED=false

# Maintenance: when MAINTENANCE_MODE=1, API returns 503 unless request includes
# a valid X-Dustswap-Maintenance-Bypass header (signed token from web unlock).
# MAINTENANCE_MODE=1
# Must match the web app's MAINTENANCE_BYPASS_SECRET (long random string).
# MAINTENANCE_BYPASS_SECRET=
