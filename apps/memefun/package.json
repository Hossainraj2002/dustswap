{
  "name": "@dustswap/memefun",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev --port 3100",
    "dev:preview": "next dev",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start --port 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "vectors": "jiti scripts/vectors.ts",
    "abis": "jiti scripts/export-abis.ts"
  },
  "dependencies": {
    "@base-org/account": "2.4.0",
    "@metamask/connect-evm": "0.9.1",
    "@number-flow/react": "^0.5.10",
    "@privy-io/chains": "0.1.4",
    "@privy-io/react-auth": "3.28.0",
    "@privy-io/wagmi": "4.0.10",
    "@tanstack/react-query": "5.95.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.22",
    "next": "15.1.11",
    "ox": "0.14.10",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "viem": "2.52.0",
    "wagmi": "3.6.0"
  },
  "pnpm": {
    "overrides": {
      "@coinbase/cdp-sdk": "1.45.0"
    }
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.8.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "9.39.4",
    "eslint-config-next": "15.1.3",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.82.2"
  }
}
