[submodule "packages/contracts/lib/openzeppelin-contracts"]
	path = packages/contracts/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "packages/contracts/lib/forge-std"]
	path = packages/contracts/lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "packages/memefun-contracts/lib/forge-std"]
	path = packages/memefun-contracts/lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "packages/memefun-contracts/lib/openzeppelin-contracts"]
	path = packages/memefun-contracts/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "packages/memefun-contracts/lib/v4-core"]
	path = packages/memefun-contracts/lib/v4-core
	url = https://github.com/Uniswap/v4-core
[submodule "packages/memefun-contracts/lib/v4-periphery"]
	path = packages/memefun-contracts/lib/v4-periphery
