# Deployment configuration only. Keep signing keys in an encrypted Foundry keystore.
# Never put private keys, mnemonic phrases or keystore passwords in this file or the repository.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Use a dedicated production RPC before mainnet deployment.
BASE_MAINNET_RPC_URL=
# Optional Etherscan V2 verification key (the old Basescan V1 key is not interchangeable).
ETHERSCAN_API_KEY=

# Set these public addresses in the deployment shell before using Deploy.s.sol.
# DEPLOYER must match the chosen encrypted keystore account.
# OWNER should be a controlled Safe on mainnet; it must accept a two-step ownership transfer.
# DEPLOYER=0x...
# OWNER=0x...
# TREASURY=0x...
# PRICE_KEEPER=0x...       # needed only for MANUAL quote assets
# REWARDS_PUBLISHER=0x...  # required before enabling public Holder-mode launches
# TWEET_ATTESTOR=0x...     # public address of the API's separate signing key

# Base Foundry is required for B20 simulation. A rehearsal must never use --broadcast.
FOUNDRY_BASE=true
DRY_RUN=true
